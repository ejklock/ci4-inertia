{
    "name": "ejklock/ci4-inertia",
    "description": "Server-side Inertia.js adapter for CodeIgniter 4.",
    "type": "library",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "inertia",
        "inertiajs",
        "adapter"
    ],
    "homepage": "https://github.com/ejklock/ci4-inertia",
    "license": "MIT",
    "authors": [
        {
            "name": "Evaldo Klock",
            "homepage": "https://github.com/ejklock",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ejklock/ci4-inertia/issues",
        "source": "https://github.com/ejklock/ci4-inertia"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "codeigniter/phpstan-codeigniter": "^1.5",
        "codeigniter4/devkit": "^1.3",
        "infection/infection": "^0.35.6",
        "phpat/phpat": "^0.12.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5.55",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Ejklock\\Ci4Inertia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ejklock\\Ci4Inertia\\Tests\\": "tests/",
            "Ejklock\\Ci4InertiaTestSupport\\": "tests/_support/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "analyze": [
            "phpstan analyse --no-progress --memory-limit=512M",
            "psalm",
            "rector process --dry-run"
        ],
        "coverage:check": "coverage-check build/logs/clover.xml 80",
        "cs": "php-cs-fixer fix --dry-run --diff --verbose",
        "cs:fix": "php-cs-fixer fix",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage infection --no-progress --min-msi=80"
        ],
        "test": "phpunit --no-coverage",
        "test:coverage": "XDEBUG_MODE=coverage phpunit",
        "test:coverage-gate": [
            "@test:coverage",
            "@coverage:check"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
